// Cloudflare Workers config for the Next.js network app (OpenNext build).
// Replaces the Vercel deployment of app.authichain.com + brand domains.
// Deploy: pnpm build:cf && pnpm deploy:cf
// Free-tier note: Workers free = 10ms CPU/request. The heavy image
// compositing paths are gated (see src/lib/hf-generation.ts) — revisit
// limits.cpu_ms after moving to the paid plan.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "authichain-app",
  // CFA-142: no public *.workers.dev address. authichain-app is reached only
  // through service bindings (govchain-us VERIFY_APP, authichain-com,
  // qron-space, strainchain-io, edge-router), which don't use workers.dev.
  // Disabled live Oct 9 2026 1:04 PM ET; this keeps a later deploy from
  // turning it back on. Rollback: delete this line.
  "workers_dev": false,
  // Thin wrapper around .open-next/worker.js that also exports RateLimiter.
  // See app-worker-entry.ts for why (Cloudflare error 10064).
  "main": "app-worker-entry.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // Last-mile: OpenNext esbuild still traces playwright-core via the cron
  // task-runner graph. worker-app/wrangler.toml already aliases it; this
  // file is the one Cloudflare Workers Builds: authichain-app actually uses.
  "alias": {
    "playwright-core": "./server/stubs/playwright-core.cjs",
    "chromium-bidi": "./server/stubs/playwright-core.cjs"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "7c8e9466e57843199f6f768615e42a5c"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "97d767ff69584161a0672cd942e9364a"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RateLimiter"]
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://app.authichain.com"
  },
  "observability": {
    "enabled": true
  }
}
