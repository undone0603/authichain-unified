  "cold_outreach": {
    "$comment": "Master switch for autonomous first-touch email. Live send needs BOTH this flag AND repo variable OWNER_LIVE_SEND=true, a clear breaker, and no pending breaker-latch approval. Switched on by the owner 2026-09-23.",
    "enabled": true,
    "max_new_prospects_per_day": 10,
    "max_followups_per_prospect": 1,
    "segments": ["qron", "strainchain", "govchain"],
    "breaker": {
      "window_days": 7,
      "max_bounce_rate": 0.03,
      "max_complaints": 0,
      "min_sample": 10
    }
  },
  "stripe_webhooks": [
    {
      "id": "we_1UGTCSGqTruSqV8ThM9bXVWp",
      "url": "https://authichain.com/api/stripe/webhook",
      "ensure_events": ["checkout.session.expired"],
      "$comment": "Re-added after audit writes became fail-open (the 400s that caused the 2026-09-23 pause)."
    }
  ],
