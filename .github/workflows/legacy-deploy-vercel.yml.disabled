name: Deploy Vercel App (DISABLED — migrated to deploy-cf-pages.yml)

# Trigger manually only; push-to-main now handled by deploy-cf-pages.yml
on:
  workflow_dispatch:

permissions:
  contents: read

env:
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true

jobs:
  deploy-worker:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        project:
          - workers/qron-automation
    name: deploy (${{ matrix.project }})
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup pnpm
        uses: pnpm/action-setup@v5
        with:
          version: '10.28.2'

      - name: Setup Node 22
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: 'pnpm'

      - name: Install dependencies
        run: pnpm install --no-frozen-lockfile

      - name: Deploy Cloudflare Worker
        run: npx wrangler deploy --minify --config wrangler.toml
        working-directory: ${{ matrix.project }}
        env:
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
