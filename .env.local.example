# ============================================================
# authichain-unified — .env.local.example
# TEMPLATE ONLY — do NOT put real secrets here
# Copy to `.env.local` and fill in your own values
# ============================================================

# ─── GITHUB ─────────────────────────────────────────────────
GITHUB_PAT=your_github_pat_here

# ─── CLOUDFLARE ─────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_ACCOUNT_ID_2=your_secondary_cloudflare_account_id
CLOUDFLARE_ZONE_ID_QRON=your_qron_zone_id
CLOUDFLARE_ZONE_ID_AUTHICHAIN=your_authichain_zone_id
CLOUDFLARE_D1_DB_ID=your_cloudflare_d1_db_id
CLOUDFLARE_KV_NAMESPACE_ID=your_cloudflare_kv_namespace_id

# ─── VERCEL ─────────────────────────────────────────────────
VERCEL_TEAM_ID=your_vercel_team_id
VERCEL_PROJECT_ID_AUTHICHAIN=your_authichain_project_id
VERCEL_PROJECT_ID_QRON=your_qron_project_id

# ─── SUPABASE ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_PROJECT_REF=your_supabase_project_ref

# ─── STRIPE ─────────────────────────────────────────────────
STRIPE_ACCOUNT_ID=your_stripe_account_id
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_1
STRIPE_WEBHOOK_SECRET_2=whsec_your_webhook_secret_2
STRIPE_WEBHOOK_SECRET_3=whsec_your_webhook_secret_3
STRIPE_PRICE_ID_1=price_your_price_id_1
STRIPE_PRICE_ID_2=price_your_price_id_2

# ─── AI / LLM PROVIDERS ─────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key

GROQ_API_KEY=your_groq_api_key
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key
PINECONE_API_KEY=your_pinecone_api_key
FAL_AI_API_KEY=your_fal_ai_api_key

HUGGINGFACE_API_KEY=your_huggingface_api_key
HF_API_KEY=your_huggingface_api_key
HUGGINGFACE_WRITE_KEY=your_huggingface_write_key

# ─── RESEND (Email) ─────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key
RESEND_DOMAIN_ID=your_resend_domain_id

# ─── TELEGRAM BOTS ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN_AUTHICHAIN=your_telegram_bot_token_authichain
TELEGRAM_BOT_TOKEN_QRON=your_telegram_bot_token_qron

# ─── SLACK ──────────────────────────────────────────────────
SLACK_APP_ID=your_slack_app_id
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_SIGNING_SECRET=your_slack_signing_secret

# ─── THIRDWEB ───────────────────────────────────────────────
THIRDWEB_CLIENT_ID=your_thirdweb_client_id

# ─── BLOCKCHAIN / ETHERSCAN ─────────────────────────────────
ETHERSCAN_API_KEY_QRON=your_etherscan_api_key_qron
ETHERSCAN_API_KEY_AUTHICHAIN_NFT=your_etherscan_api_key_authichain_nft
ETHERSCAN_API_KEY_STRAINCHAIN=your_etherscan_api_key_strainchain
# WALLET_PRIVATE_KEY is ONLY set in .env.local, never in example

# ─── DOCUSIGN ───────────────────────────────────────────────
DOCUSIGN_ACCOUNT_ID=your_docusign_account_id

# ─── LOOM ───────────────────────────────────────────────────
LOOM_API_KEY=your_loom_api_key

# ─── INTERNAL / ADMIN KEYS ──────────────────────────────────
INTERNAL_KEY_AUTHICHAIN=your_internal_key_authichain
INTERNAL_KEY_QRON=your_internal_key_qron
DEMO_TEST_KEY=your_demo_test_key
RAPIDAPI_TEST_KEY=your_rapidapi_test_key
ADMIN_SECRET=your_admin_secret

# --- Notion (Operations / Vault) ---
NOTION_API_KEY=
NOTION_DATABASE_ID=

# --- Airtable ---
AIRTABLE_TABLE_ID=tblJKef2D5SpIgEpT

# --- Vercel programmatic API token (optional) ---
VERCEL_TOKEN=
