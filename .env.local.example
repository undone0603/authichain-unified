# .env.local.example — copy to .env.local and fill in values
# Add ALL of these to each Vercel project: Settings → Environment Variables

# ── Ecosystem URLs ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://authichain.com
NEXT_PUBLIC_AUTHICHAIN_URL=https://authichain.com
NEXT_PUBLIC_QRON_URL=https://qron.io
NEXT_PUBLIC_STRAINCHAIN_URL=https://strainchain.io
NEXT_PUBLIC_GOVCHAIN_URL=https://govchain.us

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── SAM.gov (free key at api.sam.gov) ─────────────────────────────────────────
SAM_GOV_API_KEY=

# ── Pinecone vector store ─────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX=authichain-gov-opps

# ── Blockchain / Alchemy ──────────────────────────────────────────────────────
ALCHEMY_API_KEY=
WALLET_PRIVATE_KEY=
GOVCHAIN_NFT_CONTRACT=
GOVCHAIN_URL=https://govchain.us

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_GOV_CHANNEL_ID=

# ── Airtable ──────────────────────────────────────────────────────────────────
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
STRIPE_SCALE_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# --- Notion (Operations / Vault) ---
NOTION_API_KEY=
NOTION_DATABASE_ID=

# --- Airtable ---
AIRTABLE_TABLE_ID=tblJKef2D5SpIgEpT

# --- Vercel programmatic API token (optional) ---
VERCEL_TOKEN=
