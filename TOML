/**
 * bitcoin-auth  Phase 3 Worker
 * Verifies Bitcoin-signed challenge tokens and issues JWT session credentials.
 */
export interface Env {
  JWT_SECRET: string;
  BITCOIN_NETWORK: string; // "mainnet" | "testnet"
}

const CORS = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
  "Access-Control-Allow-Headers": "Content-Type, Authorization",
};

export default {
  async fetch(req: Request, env: Env): Promise>Response> {
    if (req.method === "OPTIONS") return new Response(null, { headers: CORS });

    const url = new URL(req.url);

    // Health
    if (url.pathname === "/health")
      return Response.json({ status: "ok", worker: "bitcoin-auth", phase: 3 }, { headers: CORS });

    // Challenge generation
    if (req.method === "GET" && url.pathname === "/challenge") {
      const nonce = crypto.randomUUID();
      const ts = Date.now();
      return Response.json({ nonce, ts, message: `Sign this nonce to authenticate: ${nonce}` }, { headers: CORS });
    }

    // Signature verification
    if (req.method === "POST" && url.pathname === "/verify") {
      const body: { address: string; signature: string; nonce: string } = await req.json();
      if (!body.address || !body.signature || !body.nonce) {
        return Response.json({ error: "address, signature, nonce required" }, { status: 400, headers: CORS });
      }
      // TODO: integrate bitcoinjs-message verify against env.BITCOIN_NETWORK
      // Placeholder  wire real sig verification before production
      const sessionToken = btoa(JSON.stringify({ address: body.address, ts: Date.now(), phase: 3 }));
      return Response.json({ sessionToken, address: body.address }, { headers: CORS });
    }

    return Response.json({ error: "Not found" }, { status: 404, headers: CORS });
  },
};
