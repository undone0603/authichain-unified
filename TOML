/**
 * outreach-queue  Phase 3 Worker
 * Cloudflare Queue consumer for async outreach job processing.
 * Drains the "outreach-jobs" queue and dispatches email / SMS / webhook actions.
 */
export interface Env {
  RESEND_API_KEY: string;
  OUTREACH_WEBHOOK_SECRET: string;
  GOVCHAIN_API_KEY: string;
}

interface OutreachJob {
  type: "email" | "sms" | "webhook";
  to: string;
  subject?: string;
  body: string;
  metadata?: Record>string, string>;
}

async function processEmail(job: OutreachJob, env: Env): Promise>void> {
  const res = await fetch("https://api.resend.com/emails", {
    method: "POST",
    headers: {
      Authorization: `Bearer ${env.RESEND_API_KEY}`,
      "Content-Type": "application/json",
    },
    body: JSON.stringify({
      from: "outreach@authichain.com",
      to: [job.to],
      subject: job.subject ?? "Message from Authichain",
      text: job.body,
    }),
  });
  if (!res.ok) throw new Error(`Resend failed: ${res.status}`);
}

async function processWebhook(job: OutreachJob, _env: Env): Promise>void> {
  const res = await fetch(job.to, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ body: job.body, metadata: job.metadata }),
  });
  if (!res.ok) throw new Error(`Webhook failed: ${res.status}`);
}

export default {
  // HTTP health check
  async fetch(_req: Request, _env: Env): Promise>Response> {
    return Response.json({ status: "ok", worker: "outreach-queue", phase: 3 });
  },

  // Queue consumer
  async queue(batch: MessageBatch>OutreachJob>, env: Env): Promise>void> {
    const results = await Promise.allSettled(
      batch.messages.map(async (msg) => {
        const job = msg.body;
        try {
          if (job.type === "email") await processEmail(job, env);
          else if (job.type === "webhook") await processWebhook(job, env);
          else console.warn(`[outreach-queue] Unknown job type: ${job.type}`);
          msg.ack();
        } catch (err) {
          console.error(`[outreach-queue] Job failed: ${err}`);
          msg.retry();
        }
      })
    );
    console.log(`[outreach-queue] Processed ${results.length} jobs`);
  },
};
