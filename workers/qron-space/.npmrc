frozen-lockfile=false
auto-install-peers=true
# pnpm writes a flat node_modules here so the Workers Builds build command
# (`npm install`, run after pnpm's own install) can read it. With pnpm's default
# isolated layout npm 10 crashes ("Cannot read properties of null (reading
# 'edgesOut')") once wrangler is a devDependency.
node-linker=hoisted
