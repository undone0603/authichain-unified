// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`/mcp unchanged > tools/list matches the pre-change snapshot 1`] = `"{"jsonrpc":"2.0","id":1,"result":{"tools":[{"name":"get_pricing","description":"Free. Read-only price discovery; never starts a checkout or authorizes payment. Lists live human Stripe checkouts ($29 Living QR Starter Pack at /checkout/starter, $299 EU DPP Readiness at /checkout/dpp_readiness) and free verification tools.","annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false},"inputSchema":{"type":"object","properties":{}}},{"name":"verify","description":"Legacy x402 seal verify, not answering; do not attempt to pay. Arguments that cannot be a seal UUID are HTTP 400 before payment. Empty arguments are unpaid HTTP 402 for discovery; a paid call is refused with 503 registry_not_bound before settlement, so no payment is taken. For free verification use verify_record.","annotations":{"readOnlyHint":false,"destructiveHint":true,"idempotentHint":false,"openWorldHint":true},"inputSchema":{"type":"object","properties":{"sealId":{"type":"string","format":"uuid","description":"Required seal UUID. productId and serial are not registry keys."},"tier":{"type":"string","enum":["ping","verify","evidence"],"description":"Signal tier. ping: registry existence only. verify (default): signature and validity baseline. evidence: the baseline plus a SHA-256 digest of the returned answer. The HTTP 402 quote states the exact price. No tier claims real-world authenticity."}}}},{"name":"query_provenance","description":"Free registry and published-pack lookup for an assetId / seal / QR token; use for discovery, not proof of authenticity. Reads matching rows from the canonical auth_seals registry when public Supabase configuration is available, and also resolves published packs. A registry match means registered only; it does not verify a signature or prove a physical item is genuine. Use verify_attestation for a published v0.1 JWS; verify_record is the separate reference-protocol verifier.","annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":true},"inputSchema":{"type":"object","properties":{"assetId":{"type":"string","description":"Seal, serial, or QR token identifier"}},"required":["assetId"]}},{"name":"verify_attestation","description":"Free. Use when verifying a registry-published attestation, not a supplied offline protocol record. Fetch the exact published AuthiChain v0.1 JWS from the signed-record registry and pass it to the canonical edge-router verifier. Checks signature, issuer trust, durable revocation/status, expiry, and signed decision. Supply expectedObjectId to bind the record to a scanned object identifier. A valid signed claim alone does not prove physical authenticity.","annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":true},"inputSchema":{"type":"object","properties":{"assetId":{"type":"string","description":"Unique attestation ID or exact seal/product identifier"},"expectedObjectId":{"type":"string","description":"Optional independently observed object ID to compare with the signed subject"}},"required":["assetId"]}},{"name":"verify_record","description":"Free. Use for a supplied signed protocol record or demonstration record, not published JWS issuer-status checks. Verify an AuthiChain signed provenance record with the open reference verifier. Pass id \\"polygon-anchor-1\\" for the published demonstration record, or pass your own record and anchor JSON. Returns verified, valid-unanchored, or invalid, plus whether the transaction carries the record hash. It does not inspect a physical product.","annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":true},"inputSchema":{"type":"object","properties":{"id":{"type":"string","description":"Published record id. Only \\"polygon-anchor-1\\" exists."},"record":{"type":"object","description":"A signed AuthiChain provenance record (JSON)."},"anchor":{"type":"object","description":"Anchor JSON: { recordHash, chain: \\"polygon:137\\", txHash }. Optional."}}}},{"name":"dpp_readiness_check","description":"Free informational EU Digital Product Passport readiness questionnaire; this cannot issue a passport or certify compliance. Returns a 0-100 score, gaps, and the dated obligation for the product category (battery passport is law from 18 Feb 2027; other categories are ESPR targets). Not legal advice.","annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false},"inputSchema":{"type":"object","properties":{"category":{"type":"string","enum":["battery_passport","battery_other","textiles","iron_steel","aluminium","tyres","furniture","mattresses","electronics","toys","construction","detergents","other"],"description":"battery_passport: EV, LMT (e-bike, e-scooter) or industrial battery over 2 kWh; battery_other: Other battery (portable, SLI, industrial up to 2 kWh); textiles: Textiles, apparel or footwear; iron_steel: Iron and steel; aluminium: Aluminium; tyres: Tyres; furniture: Furniture; mattresses: Mattresses; electronics: Electronics and ICT; toys: Toys; construction: Construction products; detergents: Detergents and cleaning products; other: Something else"},"sells_in_eu":{"type":"boolean","description":"Sold into the EU directly or via an importer. Default true."},"unique_id":{"type":"boolean","description":"Each product (or model or batch) has a unique identifier, such as a GS1 GTIN with serial."},"supplier_data":{"type":"boolean","description":"You can get material and substance data from your suppliers."},"market_role":{"type":"boolean","description":"You know who places the product on the EU market (you, an importer or an EU representative)."},"footprint":{"type":"boolean","description":"You have carbon or environmental footprint data for the product."},"data_host":{"type":"boolean","description":"You have a public web location where product data could be published behind a QR code."},"data_owner":{"type":"boolean","description":"A named person owns product compliance data."}},"required":["category"]}},{"name":"scan_living_qr","description":"Free. Read an existing Living QR presentation, not a QR generator or x402 purchase. Scan a stored Living QR. GET https://authichain.com/qron/r/{object_id} returns AuthiChain Verification Decision v1. This host verifies the signature. A missing id is presentation_not_found. Not an x402 payment endpoint, and it does not inspect a physical product.","annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":true},"inputSchema":{"type":"object","properties":{"object_id":{"type":"string","description":"Stored presentation id. Canonical form is qron:url: plus 8 hex characters."}},"required":["object_id"]}}]}}"`;
