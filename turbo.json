{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", ".output/**", "public/dist/**"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "lint": {},
    "check": {},
    "authichain-scan-validate#build": {
      "outputs": ["dist/**", ".next/**"]
    },
    "authichain-worker#build": {
      "outputs": ["dist/**"]
    }
  }
}
