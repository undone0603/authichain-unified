# Shared AgentZ image: docker-compose `agentz` (CLI) and
# workers/authichain-agentz (Cloudflare Containers → FastAPI).
# Build context is the monorepo root.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PORT=8000

RUN apt-get update && apt-get install -y libpq-dev gcc && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-agentz.txt .
RUN pip install --no-cache-dir -r requirements-agentz.txt
COPY . .

EXPOSE 8000

# Compose / local ops keep the CLI. Cloudflare Containers overrides
# entrypoint to: uvicorn agentz.api.main:app --host 0.0.0.0 --port 8000
CMD ["python3", "-m", "agentz.cli"]
