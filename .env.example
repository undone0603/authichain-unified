# AuthiChain Unified — Environment Variables
# Copy this file to .env and fill in real values.

# Database — use the Supabase TRANSACTION pooler (port 6543) for serverless.
# Copy the "Transaction pooler" string from Supabase → Settings → Database.
# postgres-js is configured with prepare:false in code for pgbouncer compatibility.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres

# Supabase (canonical, server-side). URL + anon key are public-by-design (RLS).
# next.config.js bridges these to NEXT_PUBLIC_* for the browser, so you only
# need the unprefixed names below — but you may also set NEXT_PUBLIC_* directly.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ-your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ-your-service-role-key
# Optional explicit client overrides (otherwise derived from the above):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI / Forge
BUILT_IN_FORGE_API_KEY=sk-your-forge-api-key
BUILT_IN_FORGE_API_URL=https://forge.manus.im
OPENAI_API_KEY=sk-your-openai-key
# Hugging Face (canonical: HF_TOKEN; HF_TOKEN_PRIMARY/HUGGINGFACE_TOKEN also read)
HF_TOKEN=hf_your-huggingface-token

# Apollo (Lead enrichment)
APOLLO_API_KEY=your-apollo-key

# Stripe (Payment processing)
STRIPE_SECRET_KEY=sk_live_your-stripe-secret
# Publishable key — NEXT_PUBLIC_* for the Next.js app; bridged in next.config.js
# from STRIPE_PUBLISHABLE_KEY if the NEXT_PUBLIC_ form is unset. VITE_* for the SPA.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# Per-product webhook signing secret used by app.authichain.com:
STRIPE_WEBHOOK_AUTHICHAIN_SECRET=whsec_your-authichain-webhook-secret

# --- AuthiChainLedger (sale anchoring) -------------------------------------
# Empty = ledger disabled. Receipts still record as pending/failed rows and
# payments are unaffected.
LEDGER_CONTRACT_ADDRESS=
LEDGER_CHAIN_ID=137

# Optional. Seconds to wait for 1 confirmation before recording the row as
# pending and letting retry-pending.ts reconcile it. Default 45000.
LEDGER_WAIT_TIMEOUT_MS=45000

# Optional, deploy-time only: grant a second recorder address.
LEDGER_EXTRA_RECORDER=

# Reused, not duplicated:
#   NFT_RPC_URL                (defaults to https://polygon-rpc.com)
#   MINTER_PRIVATE_KEY         (or THIRDWEB_MINTER_KEY)
#   STRIPE_SECRET_KEY
#   SUPABASE_SERVICE_ROLE_KEY

# Stripe Price IDs (monthly recurring) - canonical production IDs
STRIPE_PRICE_BASIC=price_1TqPJfGqTruSqV8TAjbmz3jw
STRIPE_PRICE_PRO=price_1TqPNvGqTruSqV8TirjBDQiY
STRIPE_PRICE_ENTERPRISE=price_1TqPR8GqTruSqV8T5UvdFJ2q

# Auth
JWT_SECRET=your-jwt-secret-min-32-chars
CLERK_SECRET_KEY=sk_live_your-clerk-secret
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_your-clerk-publishable

# Email (at least one of the following groups must be configured)
# Two Resend accounts hold different verified sending domains — see the
# "Outbound sender addresses" block below for which owns what.
RESEND_API_KEY=re_your-resend-key
RESEND_API_KEY2=re_your-second-resend-key
SENDGRID_API_KEY=SG.your-sendgrid-key
# Gmail SMTP (app password — enable 2FA then create at myaccount.google.com/apppasswords)
GMAIL_FROM_EMAIL=your-address@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Gmail OAuth2 (alternative to app password)
GMAIL_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-oauth-client-secret
GMAIL_REFRESH_TOKEN=1//your-refresh-token

# Outbound sender addresses.
# Every value here must sit on a domain VERIFIED at https://resend.com/domains —
# Resend rejects any send from an unverified domain, for every recipient.
# The verified domains are split across two Resend accounts:
#   RESEND_API_KEY  -> strainchain.io
#   RESEND_API_KEY2 -> authichain.com
# Both must be set for all channels to send; the preflight in
# scripts/lib/resend-preflight.ts probes them and binds each sender to whichever
# account owns its domain, so no manual domain->key mapping is maintained.
OUTREACH_FROM_EMAIL=hello@authichain.com
OUTREACH_FROM_GOVCHAIN=
OUTREACH_FROM_STRAINCHAIN=hello@strainchain.io
OUTREACH_FROM_QRON=
# Sender for government proposal emails (scripts/email-proposals.ts).
EMAIL_FROM=proposals@authichain.com

# CAN-SPAM: a real physical postal address is REQUIRED in every commercial
# email. server/outreach/send-guard.ts fails closed when this is unset — no
# outreach sends at all — rather than ship a placeholder that would itself be a
# violation. Not a secret: it is printed in every message we send. The value
# below is the address already filed on the DHS SVIP application and the state
# partnership proposals; update it here and in the workflows if it changes.
MAILING_ADDRESS=109 N 4th St, Roscommon, MI 48653-9090 USA
UNSUBSCRIBE_URL=https://authichain.com/unsubscribe
# Must be a monitored inbox — the outreach copy tells recipients to reply.
RESEND_REPLY_TO=hello@authichain.com

# Inbound Email Reply Capture & Auto-Nurture
# Configure Resend inbound route in dashboard: https://resend.com/domains
RESEND_WEBHOOK_SECRET=your-webhook-secret-from-resend-console
NURTURE_EMAIL_FROM=proposals@authichain.com
CALENDLY_URL=https://calendly.com/authichain/demo
PILOT_PRICE=$2,999
CRON_SECRET=your-secure-random-cron-secret

# HubSpot
HUBSPOT_ACCESS_TOKEN=pat-your-hubspot-token

# Blockchain (Thirdweb). Canonical secret name: THIRDWEB_SECRET_KEY.
THIRDWEB_SECRET_KEY=your-thirdweb-secret
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=your-thirdweb-client-id
BLOCKCHAIN_PRIVATE_KEY=0x-your-wallet-private-key
DEFAULT_NFT_CONTRACT=0x-your-erc721-contract-address

# OrdinalsBot (Bitcoin Ordinals inscription-as-a-service). Powers
# trpc.ordinals.createInscription (server/ordinals/router.ts). Each call is a
# real, billable on-chain Bitcoin transaction — get a key at
# https://ordinalsbot.com and fund the account before enabling this in
# production. Not set = the route throws INTERNAL_SERVER_ERROR rather than
# silently failing.
ORDINALSBOT_API_KEY=your-ordinalsbot-api-key

# SMS Alerts (Founder handshake)
SMS_RECIPIENT=your-phone@vtext.com
MAKE_WEBHOOK_URL=https://hook.us2.make.com/your-webhook-id

# Michigan cannabis extraction workspace (scripts/mi-cannabis-extraction.ts)
# Separate Supabase project from the main one. service_role — keep private.
SUPABASE_MI_URL=https://your-project.supabase.co
SUPABASE_MI_SERVICE_KEY=eyj-your-service-role-key


# --- Notion (Operations / Vault) ---
# Create an internal integration at https://www.notion.so/profile/integrations
NOTION_API_KEY=secret_your-notion-internal-integration-token
NOTION_DATABASE_ID=your-notion-database-id


# --- Airtable table id (base id already above) ---
AIRTABLE_TABLE_ID=tblJKef2D5SpIgEpT


# --- Vercel (programmatic API; project/team IDs already in .env.local) ---
VERCEL_TOKEN=your-vercel-access-token


# SignWell (Document signing - zero-cost DocuSign replacement)
# Get API key at https://app.signwell.com/account/api
SIGNWELL_API_KEY=sw_live_your-signwell-api-key
SIGNWELL_TEST_MODE=false
SIGNWELL_TEMPLATE_ID=your-signwell-template-id

# ============================================================================
# --- Auto-generated inventory: variables read via process.env but not yet
#     documented above. Generated 2026-09-12 by grepping process\.env\.[A-Z_]+
#     repo-wide and diffing against the documented vars above this line.
#
#     These are NOT all required — many are optional feature flags, dev-only
#     tooling (e.g. AGENT_BROWSER_*), or read by a specific script rather than
#     the main app. This list exists so a var is never silently undiscoverable;
#     it replaces guessing with 'grep the directory named below to see how and
#     when it's read'. Move a var above this line with a real explanation once
#     its owner documents it properly — don't leave it here.
#
#     Grouped by which top-level directory(ies) reference it.
# ============================================================================

