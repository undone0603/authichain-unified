# AuthiChain Unified — Environment Variables
# Copy this file to .env and fill in real values.

# Database (Supabase Session Pooler — Port 6543)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:6543/postgres?sslmode=require

# AI / Forge
BUILT_IN_FORGE_API_KEY=sk-your-forge-api-key
BUILT_IN_FORGE_API_URL=https://forge.manus.im
OPENAI_API_KEY=sk-your-openai-key

# Apollo (Lead enrichment)
APOLLO_API_KEY=your-apollo-key

# Stripe (Payment processing)
STRIPE_SECRET_KEY=sk_live_your-stripe-secret
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable

# Auth
JWT_SECRET=your-jwt-secret-min-32-chars

# Email (at least one of the following groups must be configured)
RESEND_API_KEY=re_your-resend-key
SENDGRID_API_KEY=SG.your-sendgrid-key
# Gmail SMTP (app password — enable 2FA then create at myaccount.google.com/apppasswords)
GMAIL_FROM_EMAIL=your-address@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Gmail OAuth2 (alternative to app password)
GMAIL_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-oauth-client-secret
GMAIL_REFRESH_TOKEN=1//your-refresh-token

# HubSpot
HUBSPOT_ACCESS_TOKEN=pat-your-hubspot-token

# Blockchain (Thirdweb)
THIRDWEB_SECRET_KEY=your-thirdweb-secret
BLOCKCHAIN_PRIVATE_KEY=0x-your-wallet-private-key
DEFAULT_NFT_CONTRACT=0x-your-erc721-contract-address

# SMS Alerts (Founder handshake)
SMS_RECIPIENT=your-phone@vtext.com
MAKE_WEBHOOK_URL=https://hook.us2.make.com/your-webhook-id

# Michigan cannabis extraction workspace (scripts/mi-cannabis-extraction.ts)
# Separate Supabase project from the main one. service_role — keep private.
SUPABASE_MI_URL=https://your-project.supabase.co
SUPABASE_MI_SERVICE_KEY=eyj-your-service-role-key


# --- Notion (Operations / Vault) ---
# Create an internal integration at https://www.notion.so/profile/integrations
NOTION_API_KEY=secret_your-notion-internal-integration-token
NOTION_DATABASE_ID=your-notion-database-id


# --- Airtable table id (base id already above) ---
AIRTABLE_TABLE_ID=tblJKef2D5SpIgEpT


# --- Vercel (programmatic API; project/team IDs already in .env.local) ---
VERCEL_TOKEN=your-vercel-access-token


# SignWell (Document signing - zero-cost DocuSign replacement)
# Get API key at https://app.signwell.com/account/api
SIGNWELL_API_KEY=sw_live_your-signwell-api-key
SIGNWELL_TEST_MODE=false
SIGNWELL_TEMPLATE_ID=your-signwell-template-id

# Admin endpoints
# Used to gate /api/admin/* routes — generate with: openssl rand -hex 32
ADMIN_DASHBOARD_KEY=your-admin-key
CRON_SECRET=your-cron-secret
