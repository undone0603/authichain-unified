{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://authichain.com/schemas/accountability-identity/v0.1",
  "title":"AuthiChain Accountability Identity",
  "type":"object",
  "required":["schema_version","identity","sources","claims","survivor_records","institutional_records","temporal_states","evidence_edges","attestation_subject"],
  "properties":{
    "schema_version":{"const":"accountability-identity.v0.1"},
    "identity":{"type":"object","required":["identity_id","canonical_name","identity_status"],"properties":{"identity_id":{"type":"string","pattern":"^acct:[a-z0-9-]+$"},"canonical_name":{"type":"string"},"identity_status":{"const":"deceased_perpetrator_record"},"description":{"type":"string"}},"additionalProperties":false},
    "sources":{"type":"array","items":{"$ref":"#/$defs/source"}},
    "claims":{"type":"array","items":{"$ref":"#/$defs/claim"}},
    "survivor_records":{"type":"array","items":{"$ref":"#/$defs/survivor_record"}},
    "institutional_records":{"type":"array","items":{"$ref":"#/$defs/institutional_record"}},
    "temporal_states":{"type":"array","items":{"$ref":"#/$defs/temporal_state"}},
    "evidence_edges":{"type":"array","items":{"$ref":"#/$defs/evidence_edge"}},
    "attestation_subject":{"type":"object","required":["subject_type","canonicalization","manifest_hash_input"],"properties":{"subject_type":{"const":"accountability_identity_manifest"},"canonicalization":{"const":"jcs-rfc8785"},"manifest_hash_input":{"type":"string"}},"additionalProperties":false}
  },
  "$defs":{
    "source":{"type":"object","required":["source_id","title","publisher","source_type","url","retrieved_at","rights"],"properties":{"source_id":{"type":"string","pattern":"^src:[a-z0-9-]+$"},"title":{"type":"string"},"publisher":{"type":"string"},"source_type":{"enum":["primary","court_record","government_report","archival_record","secondary"]},"url":{"type":"string","format":"uri"},"retrieved_at":{"type":"string","format":"date-time"},"rights":{"type":"object","required":["status"],"properties":{"status":{"enum":["public_domain","repository_terms","unknown","mixed"]},"notes":{"type":"string"}},"additionalProperties":false},"locator":{"type":"string"},"content_hash":{"type":"string"}},"additionalProperties":false},
    "claim":{"type":"object","required":["claim_id","subject","predicate","object","evidence_state"],"properties":{"claim_id":{"type":"string","pattern":"^claim:[a-z0-9-]+$"},"subject":{"type":"string"},"predicate":{"type":"string"},"object":{},"valid_from":{"type":"string"},"valid_to":{"type":"string"},"evidence_state":{"enum":["documented","adjudicated","testimonial","corroborated","alleged_disputed","unknown"]},"notes":{"type":"string"}},"additionalProperties":false},
    "survivor_record":{"type":"object","required":["record_id","visibility","identifier_policy"],"properties":{"record_id":{"type":"string","pattern":"^survivor:[a-z0-9-]+$"},"visibility":{"enum":["public_pseudonymous","restricted","counsel_only","excluded"]},"identifier_policy":{"const":"no_direct_identifier"},"claim_ids":{"type":"array","items":{"type":"string"}},"consent_note":{"type":"string"}},"additionalProperties":false},
    "institutional_record":{"type":"object","required":["record_id","entity","relation"],"properties":{"record_id":{"type":"string","pattern":"^inst:[a-z0-9-]+$"},"entity":{"type":"string"},"relation":{"enum":["investigation","prosecution","custody","oversight","compensation","document_repository","other"]},"notes":{"type":"string"}},"additionalProperties":false},
    "temporal_state":{"type":"object","required":["state_id","as_of","knowledge_cutoff","location","known_claim_ids","unknown_topics"],"properties":{"state_id":{"type":"string","pattern":"^state:[a-z0-9-]+$"},"as_of":{"type":"string"},"knowledge_cutoff":{"type":"string"},"location":{"type":"string"},"known_claim_ids":{"type":"array","items":{"type":"string"}},"unknown_topics":{"type":"array","items":{"type":"string"}},"redaction_policy":{"type":"string"}},"additionalProperties":false},
    "evidence_edge":{"type":"object","required":["edge_id","from","to","relation"],"properties":{"edge_id":{"type":"string","pattern":"^edge:[a-z0-9-]+$"},"from":{"type":"string"},"to":{"type":"string"},"relation":{"enum":["supports","contextualizes","contradicts","derived_from","bounds","redacts"]},"notes":{"type":"string"}},"additionalProperties":false}
  },
  "additionalProperties":false
}