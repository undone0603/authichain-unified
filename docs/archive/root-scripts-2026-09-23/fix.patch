@@ -0,0 +1,18 @@
+import { seoPages } from "@/drizzle/schema";
+import { InferInsertModel } from "drizzle-orm";
+
+// Insert type for SEO pages, inferred from the Drizzle table.
+export type InsertSeoPageRow = InferInsertModel<typeof seoPages>;
+
+export function insertSeoPage(db: any, row: InsertSeoPageRow) {
+  return db.insert(seoPages).values(row);
+}
