{
  "version": 2,
  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "crons": [
    { "path": "/api/cron/pipeline",                           "schedule": "0 0 * * *" },
    { "path": "/api/automation/cron",                         "schedule": "0 6 * * *" },
    { "path": "/api/cron/jobs?job=subscription-health-check", "schedule": "0 3 * * *" },
    { "path": "/api/cron/jobs?job=customer-health-score",     "schedule": "0 5 * * *" },
    { "path": "/api/cron/govchain",                           "schedule": "0 7 * * *" },
    { "path": "/api/cron/jobs?job=dunning-escalation",        "schedule": "0 8 * * *" },
    { "path": "/api/cron/retention",                          "schedule": "0 9 * * *" },
    { "path": "/api/trial-reminder",                          "schedule": "0 10 * * *" },
    { "path": "/api/cron/jobs?job=founder-payout",            "schedule": "0 9 1 * *" },
    { "path": "/api/cron/competitive-monitor",               "schedule": "0 6 * * 1" }
  ],
  "rewrites": [
    {
      "source": "/gov",
      "destination": "https://govchain.us"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",       "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "ignoreCommand": "bash -c 'if [ \"$VERCEL_ENV\" = \"production\" ]; then exit 1; fi; git diff --quiet HEAD~1 -- src/ pages/ public/ workers/ scripts/ lib/ shared/ next.config.js package.json vercel.json && exit 0 || exit 1'"
}
