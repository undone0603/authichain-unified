{
  "version": 2,
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/server.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/autonomous-pipeline-tick", "schedule": "*/2 * * * *" },
    { "path": "/api/cron/subscription-health-check", "schedule": "0 6 * * *" },
    { "path": "/api/cron/certificate-expiry-check",  "schedule": "0 7 * * *" },
    { "path": "/api/cron/lead-nurturing",            "schedule": "0 9 * * *" },
    { "path": "/api/cron/database-cleanup",          "schedule": "0 3 * * *" },
    { "path": "/api/cron/weekly-analytics-digest",   "schedule": "0 8 * * 1" },
    { "path": "/api/cron/hubspot-crm-sync",          "schedule": "0 */4 * * *" },
    { "path": "/api/cron/customer-health-score",     "schedule": "0 5 * * *" },
    { "path": "/api/cron/fraud-detection-sweep",     "schedule": "0 */6 * * *" }
  ]
}
