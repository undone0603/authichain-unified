{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*", "./client/src/*"],
      "@shared/*": ["./shared/*"],
      "@server/*": ["./server/*"],
      "@authichain/verifier": ["./packages/verifier/src/index.ts"],
      "@authichain/evidence": ["./packages/evidence/src/index.ts"],
      "@authichain/policy": ["./packages/policy/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "client/**/*.ts",
    "client/**/*.tsx",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "shared/**/*",
    "server/**/*.ts",
    "server/**/*.tsx",
    "worker-app/**/*.ts",
    "worker-app/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "packages/verifier/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "workers/**/*",
    "worker/**/*",
    "worker-app/**/*",
    "mobile/**/*",
    "packages/**/*",
    "apps/**/*",
    "docs/technical-reference/**/*",
    "content/**/*",
    "libs/**/*",
    "scripts/verify-integrations.ts",
    "scripts/ledger/deploy.ts",
    "api/**/*",
    "server/src/**/*",
    "server/scripts/**/*",
    "server/executive/**/*",
    "server/_core/context.workers.ts",
    "server/_core/context.workers.test.ts",
    "app/**/*",
    "open-next.config.ts",
    "scripts/ab-test-report.ts",
    "scripts/assign-ab-variant.ts",
    "scripts/ingest-sam.ts",
    "sentry.client.config.ts",
    "sentry.edge.config.ts",
    "sentry.server.config.ts"
  ]
}
