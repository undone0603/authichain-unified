{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "types": [
      "node",
      "vite/client"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*",
        "./client/src/*"
      ],
      "@shared/*": [
        "./shared/*"
      ],
      "@server/*": [
        "./server/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "shared/**/*",
    "server/**/*.ts",
    "server/**/*.tsx",
    "worker-app/**/*.ts",
    "worker-app/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "workers/**/*",
    "worker/**/*",
    "worker-app/**/*",
    "mobile/**/*",
    "packages/**/*",
    "scripts/**/*",
    "libs/**/*",
    "client/**/*",
    "apps/**/*",
    "api/**/*",
    "server/src/**/*",
    "server/scripts/**/*",
    "server/executive/**/*",
    "server/_core/context.workers.ts",
    "server/_core/context.workers.test.ts",
    "app/**/*",
    "open-next.config.ts",
    "src/db/qron_schema.ts",
    "sentry.client.config.ts",
    "sentry.edge.config.ts",
    "sentry.server.config.ts"
  ]
}
