{
  "name": "authichain-verify",
  "version": "0.1.1",
  "description": "Offline verifier for AuthiChain provenance records and Ed25519 attestation seals (JWS + JWKS). Zero dependencies, runs without contacting any AuthiChain server.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Zachary Kietzman (AuthiChain)",
  "homepage": "https://github.com/undone0603/authichain-unified/tree/main/protocol#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/undone0603/authichain-unified.git",
    "directory": "protocol"
  },
  "bugs": {
    "url": "https://github.com/undone0603/authichain-unified/issues"
  },
  "keywords": [
    "authichain",
    "verifier",
    "offline-verification",
    "provenance",
    "product-authentication",
    "anti-counterfeiting",
    "verifiable-credentials",
    "did-key",
    "ed25519",
    "eddsa",
    "jws",
    "jwks",
    "jcs",
    "rfc8785",
    "digital-product-passport",
    "dpp",
    "gs1",
    "gs1-digital-link",
    "supply-chain",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "./verifier.mjs",
  "types": "./verifier.d.ts",
  "exports": {
    ".": {
      "types": "./verifier.d.ts",
      "import": "./verifier.mjs",
      "default": "./verifier.mjs"
    },
    "./package.json": "./package.json",
    "./passport": {
      "types": "./passport.d.ts",
      "import": "./passport.mjs",
      "default": "./passport.mjs"
    }
  },
  "bin": {
    "authichain-verify": "./bin/authichain-verify.mjs"
  },
  "files": [
    "verifier.mjs",
    "verifier.d.ts",
    "passport.mjs",
    "passport.d.ts",
    "bin/authichain-verify.mjs",
    "examples/record.json",
    "examples/polygon-anchor-1.record.json",
    "examples/attestation-fixture.jws",
    "examples/attestation-fixture-tampered.jws",
    "examples/attestation-fixture.jwks.json",
    "examples/polygon-anchor-1.anchor.json",
    "SPEC.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "conformance": "node conformance/run.mjs --strict -- node verifier.mjs",
    "prepublishOnly": "node conformance/run.mjs --strict -- node verifier.mjs",
    "test": "cd .. && vitest run --environment node protocol/verifier.test.mjs protocol/jws.test.mjs protocol/conformance/conformance.test.mjs",
    "test:python": "cd python && PYTHONPATH=src python3 -m unittest discover -s tests && cd .. && PYTHONPATH=python/src node conformance/run.mjs --strict -- python3 -m authichain_verify"
  }
}
