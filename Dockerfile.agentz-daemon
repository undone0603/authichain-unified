FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

COPY requirements-agentz.txt ./
RUN pip install --no-cache-dir -r requirements-agentz.txt

# Copy only AgentZ source; do not bake repository environment files or secrets into the image.
COPY agentz ./agentz

CMD ["python3", "-m", "agentz.daemon"]
