# Normalize line endings in the repo. A commit that rewrote these files to CRLF
# (fc9106eb) coincided with pnpm-lock.yaml corruption that broke every CI
# `pnpm install` with ERR_PNPM_BROKEN_LOCKFILE. Force LF for text so a Windows
# checkout can't reintroduce it.
* text=auto eol=lf

# Shell scripts and workflow YAML break at runtime with CR (`\r: command not found`).
*.sh             text eol=lf
*.yml            text eol=lf
*.yaml           text eol=lf

# Lockfiles and configs: never touch, never convert. Must come after the *.yaml/
# *.yml rules above: gitattributes is last-match-wins per pattern, pnpm-lock.yaml
# matches *.yaml too, and this block previously came first, so the *.yaml rule
# silently won and forced EOL conversion on pnpm-lock.yaml anyway.
pnpm-lock.yaml   -text linguist-generated=true
package-lock.json -text linguist-generated=true
*.lock           -text

# Binaries: leave alone.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
