# AuthiChain Unified Autonomous Configuration
# ----------------------------------------------------------------------
# Activated on 2026-05-12 for full "Headless" Business Operations.

# Enable the core autonomous mission runner
AUTONOMOUS_PIPELINE_ENABLED=true

# Disable safety dry-run to allow real outreach/minting/social
DRY_RUN=false

# Auto-approval flags (Headless mode)
REQUIRE_OUTREACH_APPROVAL=false
REQUIRE_SCHEMA_MIGRATION_APPROVAL=false

# Deployment target indicators
NODE_ENV=production
IS_PRODUCTION=true

