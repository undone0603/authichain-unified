          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Does Sunrise 2027 require blockchain?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No — Sunrise 2027 is a GS1 retail-scanning standard. Anchoring the record on-chain is optional and adds tamper-evidence on top of a compliant Digital Link QR code."
